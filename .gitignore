# 评估产物（平铺在项目根 output/<factor>/）
output/

# 备份目录（mv -bak 隔离用）
*.bak/

# 数据文件
*.parquet
# 例外：回归 baseline parquet（小，要进 git）
!scripts/regression_baselines/*.parquet
scripts/regression_baselines/_eval_artifacts/

# Factor Inventory：inventory.parquet 进 git；plots 与 latest 软链不进 git
!factor_inventory/*/inventory.parquet
factor_inventory/latest
factor_inventory/*/plots/
# 因子相关性快照：matrix.parquet + summary.md + heatmap.png 都进 git（审计 trail）
!factor_inventory/correlation/*/matrix.parquet

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/

# 环境配置
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
/factor_inventory/
